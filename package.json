{
  "name": "wealth-garden",
  "displayName": "財富花園 Wealth Garden",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "WEALTH GARDEN — NEON CITY 個人財富管理網頁版／PWA（金錢・時間・心力三維紀錄）",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "build": "npm run typecheck && npm test && node scripts/build.mjs && npm run pwa:generate",
    "pwa:generate": "node scripts/generate-pwa.mjs",
    "pwa:verify": "node scripts/verify-pwa.mjs",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
